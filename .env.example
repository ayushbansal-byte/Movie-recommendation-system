# ── Copy this file to .env and fill in your values ──────────────────────────
# Environment Variables (Unit 7 – syllabus)

PORT=3000

# MongoDB Atlas connection string  (Unit 5)
# Get yours from https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/movie-mania?retryWrites=true&w=majority

# JWT secret – change this to a long random string in production
JWT_SECRET=movie_mania_dev_secret_change_in_prod
JWT_EXPIRES_IN=7d

# Node environment
NODE_ENV=development
